{
  "name": "block-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "API de analise de compatibilidade para modpacks de Minecraft.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "catalog:ingest:modrinth": "tsx src/scripts/ingest-modrinth.ts",
    "catalog:ingest:modrinth:top": "tsx src/scripts/ingest-modrinth-top.ts",
    "catalog:import:snapshot": "tsx src/scripts/import-catalog-snapshot.ts",
    "compatibility:smoke": "tsx src/scripts/smoke-compatibility.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:schema:apply": "node scripts/apply-db-schema.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@types/pg": "^8.20.0",
    "hono": "^4.8.5",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
